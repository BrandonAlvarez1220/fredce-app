{
  "expo": {
    "name": "Fredce Campo",
    "slug": "fredceapp-tecnico",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "fredceapp",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDisplayName": "Fredce Campo",
        "NSCameraUsageDescription": "Se usa la cámara para fotografiar válvulas durante el servicio."
      }
    },
    "android": {
      "package": "com.fredce.tecnico",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Se usa la cámara para fotografiar válvulas durante el servicio."
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "https://control.fredce.com/api/tecnico",
      "router": {},
      "eas": {
        "projectId": "f2cd4a80-2df7-4904-b0d9-cab647afd327"
      }
    }
  }
}
