# Copia este archivo a ".env" (fuera del control de versiones) y llena con
# los datos reales del hosting. NUNCA subir el .env real al repo.

DB_HOST=localhost
DB_NAME=fredceapp
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Tiempo de vida de los tokens de sesión del técnico (segundos). 30 días,
# porque el técnico puede pasar varios días sin señal.
TOKEN_TTL_SECONDS=2592000

# Google Drive: pendiente de definir (cuenta de servicio de la empresa).
# Mientras DRIVE_ENABLED=false, el API acepta fotos y guarda un
# drive_file_id de marcador de posición en vez de subir de verdad.
DRIVE_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
